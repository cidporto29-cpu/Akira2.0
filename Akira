local RAGDOLL_STATES = {
    [Enum.HumanoidStateType.Ragdoll] = true,
    [Enum.HumanoidStateType.Physics] = true,
    [Enum.HumanoidStateType.FallingDown] = true,
}
local RAGDOLL_CLASSES = {
    BallSocketConstraint = true,
    NoCollisionConstraint = true,
    HingeConstraint = true,
    RigidConstraint = true,
}

RunService.Heartbeat:Connect(function()
    if not CFG.AntiRagdoll then return end
    local char = character()
    local h = humanoid()
    if not char or not h then return end
    pcall(function()
        for state in pairs(RAGDOLL_STATES) do h:SetStateEnabled(state, false) end
        if h.PlatformStand then h.PlatformStand = false end
        if h.Sit then h.Sit = false end
        local st = h:GetState()
        if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll then
            h:ChangeState(Enum.HumanoidStateType.Running)
        end
        for _, d in ipairs(char:GetDescendants()) do
            if RAGDOLL_CLASSES[d.ClassName] then
                d:Destroy()
            elseif d:IsA("Motor6D") and not d.Enabled then
                d.Enabled = true
            end
        end
    end)
end)

