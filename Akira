    }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    track.Parent = card

    local pct = math.clamp((valor - min) / (max - min), 0, 1)
    local fill = new("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = C.Roxo,
        BorderSizePixel = 0,
    }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    fill.Parent = track

    local knob = new("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(pct, -9, 0.5, -9),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
    }, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    knob.Parent = track

    local dragging = false
    local function update(input)
        local abs = track.AbsolutePosition.X
        local sz = track.AbsoluteSize.X
        if sz <= 0 then return end
        local p = math.clamp((input.Position.X - abs) / sz, 0, 1)
        local v = math.floor(min + (max - min) * p)
        valLbl.Text = tostring(v)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, -9, 0.5, -9)
        if callback then callback(v) end
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return card
end

local function novoBotao(parent, nome, cor, callback)
