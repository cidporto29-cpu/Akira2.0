--═══════════════════════════════════════════════════════════════
local Fly = { conn = nil, bv = nil, bg = nil }

function Fly.start()
    local char = character()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local h = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    h.PlatformStand = true
    pcall(function() Fly.stop() end)

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    Fly.bv = bv

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 1500
    bg.D = 60
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp
    Fly.bg = bg

    Fly.conn = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam or not hrp.Parent then return end
        local dir = Vector3.zero
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector

        if FlyKeys.W then dir += look end
        if FlyKeys.S then dir -= look end
        if FlyKeys.D then dir += right end
        if FlyKeys.A then dir -= right end
        if FlyKeys.Space then dir += Vector3.new(0, 1, 0) end
        if FlyKeys.Ctrl then dir -= Vector3.new(0, 1, 0) end
        if dir.Magnitude > 0 then dir = dir.Unit * CFG.FlightSpeed end

        bv.Velocity = dir
        bg.CFrame = CFrame.new(hrp.Position, hrp.Position + look)
    end)
end

function Fly.stop()
    if Fly.conn then pcall(function() Fly.conn:Disconnect() end) Fly.conn = nil end
    if Fly.bv then pcall(function() Fly.bv:Destroy() end) Fly.bv = nil end
    if Fly.bg then pcall(function() Fly.bg:Destroy() end) Fly.bg = nil end
    local h = humanoid()
    if h then h.PlatformStand = false end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = true end
    if input.KeyCode == Enum.KeyCode.A then FlyKeys.A = true end
    if input.KeyCode == Enum.KeyCode.S then FlyKeys.S = true end
    if input.KeyCode == Enum.KeyCode.D then FlyKeys.D = true end
    if input.KeyCode == Enum.KeyCode.Space then FlyKeys.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftControl then FlyKeys.Ctrl = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = false end
    if input.KeyCode == Enum.KeyCode.A then FlyKeys.A = false end
    if input.KeyCode == Enum.KeyCode.S then FlyKeys.S = false end
    if input.KeyCode == Enum.KeyCode.D then FlyKeys.D = false end
