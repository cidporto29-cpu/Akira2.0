--═══════════════════════════════════════════════════════════════
local function ativarAntiKick()
    pcall(function()
        if hookfunction then
            local old = hookfunction(localPlayer.Kick, function(self, msg)
                if CFG.AntiKick then
                    warn("[Zazak] Kick bloqueado: " .. tostring(msg))
                    return nil
                end
                return old(self, msg)
            end)
        end
    end)
    pcall(function()
        if getrawmetatable and setreadonly and newcclosure then
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local old = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local m = getnamecallmethod and getnamecallmethod()
                if CFG.AntiKick and m == "Kick" and typeof(self) == "Instance" and self:IsA("Player") then
                    return nil
                end
                return old(self, ...)
            end)
            setreadonly(mt, true)
        end
    end)
end

