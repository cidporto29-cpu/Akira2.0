local function new(class, props, children)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do pcall(function() obj[k] = v end) end
    for _, c in ipairs(children or {}) do pcall(function() c.Parent = obj end) end
    return obj
end

