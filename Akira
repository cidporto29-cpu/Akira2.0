local function listarOvos()
    local rem = remote("RF/EggWorld/AskFieldEggSnapshot")
    if not rem then return {} end
    local ok, result = pcall(function() return rem:InvokeServer() end)
    if not ok or type(result) ~= "table" then return {} end
    local recs = result.Records
    if type(recs) ~= "table" then return {} end
    local lista = {}
    for _, rec in pairs(recs) do
        if type(rec) == "table" and type(rec.Uid) == "string"
           and (rec.State == "Slot" or rec.State == "Dropped")
           and typeof(rec.BottomCFrame) == "CFrame" then
            lista[#lista + 1] = rec
        end
    end
    return lista
end

local function pegarOvo(rec)
    local rem = remote("RF/EggWorld/AskFieldEggCarry")
    if not rem then return false end
    local firstAreaSlotKey = rec.FirstAreaSlotKey
    if not firstAreaSlotKey then
        local slotKey = rec.Uid:match(":(Slot_%d+)$")
        local area = tostring(rec.AreaId or "Forest")
        if slotKey then firstAreaSlotKey = area .. ":" .. slotKey end
    end
    local args = { Uid = rec.Uid }
    if firstAreaSlotKey then args.FirstAreaSlotKey = firstAreaSlotKey end
    local ok = pcall(function() rem:InvokeServer(args) end)
    if ok then return true end
    return pcall(function() rem:InvokeServer({ Uid = rec.Uid }) end)
end

local function equiparOvo(uid)
    local rem = remote("RF/EggWorld/AskWearTool")
    if not rem then return false end
    return pcall(function() rem:InvokeServer(uid) end)
end

local function equiparMelhor()
    local rem = remote("RF/Haul/WearBest")
    if not rem then return false end
    return pcall(function() rem:InvokeServer() end)
end

local function baterNo(player)
    local rem = remote("RE/BatSwing/Trigger")
    if not rem then return false end
    return pcall(function() rem:FireServer(player) end)
end

--═══════════════════════════════════════════════════════════════
-- INSTANT STEAL (loop otimizado)
--═══════════════════════════════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(CFG.Intervalo)
        if CFG.InstantSteal then
            local ovos = listarOvos()
            if #ovos > 0 then
                -- Pega o maior
                local melhor = ovos[1]
                for _, o in ipairs(ovos) do
                    if (tonumber(o.AssetScale) or 1) > (tonumber(melhor.AssetScale) or 1) then
                        melhor = o
                    end
                end
                local hrp = root()
                if hrp and typeof(melhor.BottomCFrame) == "CFrame" then
                    local pos = melhor.BottomCFrame.Position
                    if (hrp.Position - pos).Magnitude > 3 then
                        pcall(function()
                            hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                    pegarOvo(melhor)
                end
            end
        end
    end
end)

