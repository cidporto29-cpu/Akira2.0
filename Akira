-- ESP OVOS
--═══════════════════════════════════════════════════════════════
local ESP = { ovos = {} }

task.spawn(function()
    while true do
        task.wait(0.6)
        if CFG.ES_Ovos then
            local vistos = {}
            for _, rec in ipairs(listarOvos()) do
                local uid = rec.Uid
                vistos[uid] = true
                if not ESP.ovos[uid] then
                    local dummy = Instance.new("Part")
                    dummy.Anchored = true
                    dummy.CanCollide = false
                    dummy.CanQuery = false
                    dummy.CanTouch = false
                    dummy.Transparency = 1
                    dummy.Size = Vector3.new(0.1, 0.1, 0.1)
                    dummy.CFrame = CFrame.new(rec.BottomCFrame.Position)
                    dummy.Name = "ZazakESP"
                    dummy.Parent = workspace

                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(150, 70, 255)
                    hl.OutlineColor = Color3.fromRGB(210, 140, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = dummy
                    hl.Parent = dummy

                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0, 160, 0, 50)
                    bb.StudsOffset = Vector3.new(0, 3, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = dummy

                    local nome = tostring(rec.AssetCategory or "Egg")
                    if Assets and Assets.Directory then
                        local d = Assets.Directory[tostring(rec.AssetCategory)]
                        if d and d.DisplayName then nome = tostring(d.DisplayName) end
                    end

                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.fromScale(1, 1)
                    txt.BackgroundTransparency = 1
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 12
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.TextStrokeTransparency = 0
                    txt.Text = nome
                    txt.Parent = bb

                    ESP.ovos[uid] = dummy
                else
                    pcall(function()
                        ESP.ovos[uid].CFrame = CFrame.new(rec.BottomCFrame.Position)
                    end)
                end
            end
            -- remove antigos
            for uid, dummy in pairs(ESP.ovos) do
                if not vistos[uid] then
                    pcall(function() dummy:Destroy() end)
                    ESP.ovos[uid] = nil
                end
            end
        else
            if next(ESP.ovos) then
                for k, v in pairs(ESP.ovos) do
                    pcall(function() v:Destroy() end)
                    ESP.ovos[k] = nil
                end
            end
        end
    end
end)

